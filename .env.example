# Copy to .env ONLY if you want live Gemini answers. Without it the app runs in demo mode.
GEMINI_API_KEY=
# Verify the current stable model name at https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-3.1-flash-lite
LLM_TIMEOUT_SECONDS=20
EMBEDDING_BACKEND=auto        # auto | sentence-transformers | tfidf
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RETRIEVAL_TOP_K=3
LOG_LEVEL=INFO
